#!/usr/bin/env bash
# Builds the dummy app's assets the way a wulin_master v3 host does
# (wulin_master/templates/wulin_master.rb): the wulin gems sit under
# vendor/gems, esbuild bundles application.js, dart-sass compiles
# application.sass. The gems are copied from the checkouts Bundler resolved
# (a symlink would put this machine's path in the lockfile).
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p vendor/gems
for gem in wulin_master wulin_permits; do
  path=$(bundle exec ruby -e "print Gem.loaded_specs.fetch('$gem').full_gem_path")
  rm -rf "vendor/gems/$gem"
  cp -R "$path" "vendor/gems/$gem"
done

bin/rails wulin_agent:assets:build
npm ci --no-audit --no-fund
npm run copy-icons
bin/rails wulin_master:generate_theme_color_css
npm run build
bin/rails dartsass:build
