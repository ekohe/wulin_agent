.ruby-version
pkg/*
*.gem
.bundle
*.log
.DS_Store
spec/dummy/log/
spec/dummy/config/database.yml
spec/dummy/.env
spec/dummy/config/wulin_agent_actions.rb
spec/dummy/tmp/
# Precompiled assets shadow the live app/assets/builds bundle in dev/test
spec/dummy/public/assets/
spec/dummy/storage/
# ignore the bundle folder
vendor/bundle/
# Built by `bin/rails wulin_agent:assets:build` (also runs before assets:precompile)
app/assets/builds/*
!app/assets/builds/.keep
# JavaScript dependencies (reinstall with npm ci in app/)
/node_modules/
app/node_modules/
spec/dummy/node_modules/
